{
  "name": "remote-omp",
  "version": "0.7.0",
  "description": "Mobile remote control and local agent mesh for the omp (oh-my-pi) coding agent. Pair your phone via QR over a relay, watch tool calls in real time, run multi-omp sessions over a local Unix Domain Socket broker, and let agents talk to each other through structured request/reply.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "remote-omp": "dist/index.js",
    "remote-omp-supervisord": "dist/bin/supervisord.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "omp-extension",
    "remote-control",
    "mobile",
    "coding-agent",
    "agent-mesh",
    "agent-network",
    "uds",
    "broker",
    "qr-pairing",
    "websocket"
  ],
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "author": "Jacob Moura <jacobmoura7@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoliu0/remote-omp.git",
    "directory": "omp-extension"
  },
  "homepage": "https://remote-pi.jacobmoura.work",
  "bugs": {
    "url": "https://github.com/leoliu0/remote-omp/issues"
  },
  "files": [
    "dist",
    "skills",
    "service-templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/ed25519": "^3.1.0",
    "croner": "^10.0.1",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.1.38",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
